{
  "name": "evalpilot-local",
  "version": "0.6.0-alpha.0",
  "description": "Local, evidence-first pre-release evaluation CLI for web products",
  "type": "module",
  "bin": {
    "evalpilot": "dist/src/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:dashboard": "vite build",
    "check": "tsc --noEmit",
    "dev": "tsx src/cli/index.ts",
    "dashboard": "npm run build && node dist/src/cli/index.js dashboard",
    "test": "vitest run",
    "test:browser": "EVALPILOT_BROWSER_TEST=1 vitest run tests/browser-evidence.test.ts",
    "test:runner": "EVALPILOT_BROWSER_TEST=1 vitest run tests/runner-browser.test.ts tests/action-executor-grounding.test.ts",
    "test:ai-agent": "EVALPILOT_BROWSER_TEST=1 vitest run tests/ai-test-agent.test.ts tests/evidence-gate.test.ts tests/hybrid-judge.test.ts tests/progress-aware-wait.test.ts tests/safe-setup-runner.test.ts tests/transitive-safe-setup.test.ts tests/setup-checkpoint.test.ts tests/synthetic-file-upload.test.ts tests/auth-session-fixture.test.ts tests/combined-prerequisite-browser.test.ts && tsx scripts/verify-task-state-browser-serialization.ts && tsx scripts/verify-observer-browser-serialization.ts",
    "test:semantic-verifier": "EVALPILOT_BROWSER_TEST=1 vitest run tests/semantic-verifier.test.ts tests/semantic-verifier-browser.test.ts",
    "test:product-understanding": "vitest run tests/product-task-understanding.test.ts tests/query-entrypoint-normalization.test.ts",
    "test:dashboard": "EVALPILOT_DASHBOARD_TEST=1 vitest run tests/dashboard-browser.test.ts tests/project-workspace.test.ts",
    "test:public-example": "npm run build && node scripts/verify-public-example.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:benchmark": "tsx src/cli/index.ts benchmark --json",
    "test:real-benchmark": "EVALPILOT_BROWSER_TEST=1 vitest run tests/real-evaluator-benchmark.test.ts tests/experience-detector-browser-calibration.test.ts tests/dead-end-recovery-boundary-browser.test.ts",
    "test:evaluator-regression": "EVALPILOT_BROWSER_TEST=1 vitest run tests/evaluator-regression",
    "acceptance:gate": "tsx scripts/evaluate-real-product-acceptance.ts",
    "audit:package": "node scripts/audit-package.mjs",
    "test:consumer": "node scripts/verify-consumer.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chusday97/evalpilot-local.git"
  },
  "homepage": "https://github.com/chusday97/evalpilot-local#readme",
  "bugs": {
    "url": "https://github.com/chusday97/evalpilot-local/issues"
  },
  "keywords": [
    "ai-evaluation",
    "ux-testing",
    "playwright",
    "local-first",
    "codex"
  ],
  "files": [
    "dist/**/*.js",
    "dist-dashboard/",
    "skills/evalpilot/",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "playwright": "1.61.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
